---
/**
 * 文章卡片（消费 blog/PostCard 原子）。
 * 只负责取数转 props：封面候选、日期格式化、分类/标签 URL、字数文案。
 */
import PostCard from "@components/atoms/blog/PostCard.astro";
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
import { formatDateToYYYYMMDD } from "@utils/date-utils";
import { getCategoryUrl, getTagUrl } from "@utils/url-utils";
import type { PostView } from "@/lib/content/posts";

interface Props {
	class?: string;
	post: PostView;
	style: string;
}
const { post, style } = Astro.props;
const className = Astro.props.class;

// 媒体库为封面生成 384px 缩略图与展示图；卡片按宽度挑选。
const { cover } = post;
const coverSrcset = cover?.thumbUrl
	? [`${cover.thumbUrl} 384w`, cover.width ? `${cover.url} ${cover.width}w` : ""]
			.filter(Boolean)
			.join(", ")
	: undefined;

const categoryLink = post.category
	? { name: post.category.name, href: getCategoryUrl(post.category.slug) }
	: null;
const tagLinks = post.tags.map((t) => ({ name: t.name, href: getTagUrl(t.slug) }));

const words = post.wordCount;
const wordCount = `${words} ${i18n(words === 1 ? I18nKey.wordCount : I18nKey.wordsCount)}`;
---

<PostCard
	class={className}
	style={style}
	href={post.url}
	title={post.title}
	description={post.description}
	image={cover?.url}
	imageSrcset={coverSrcset}
	imageSizes="(max-width: 767px) calc(100vw - 4rem), (min-width: 1280px) 342px, 28vw"
	imageWidth={cover?.width ?? undefined}
	imageHeight={cover?.height ?? undefined}
	imageAlt={cover?.alt ?? ""}
	published={formatDateToYYYYMMDD(post.published)}
	updated={formatDateToYYYYMMDD(post.updated)}
	pinned={post.pinned}
	category={categoryLink}
	tags={tagLinks}
	wordCount={wordCount}
/>
