---
/**
 * 页脚（消费 blog/FooterBar 原子）。
 * 版权名称/年份、RSS/Sitemap 链接、Powered by，以及管理员设置的页脚 HTML。
 * 页脚 HTML 是受信任的管理员代码；其中的 <script> 由 Layout 在文档末尾只输出一次。
 */
import FooterBar from "@components/atoms/blog/FooterBar.astro";
import { url } from "@utils/url-utils";
import { splitTrustedHtml } from "@/lib/site/trusted-html";

const { profileConfig, footerHtml, version } = Astro.locals.site;
const currentYear = new Date().getFullYear();
const links = [
	{ label: "RSS", href: url("rss/") },
	{ label: "Sitemap", href: url("sitemap.xml"), external: true },
];
const poweredBy = [
	{ label: "Astro", href: "https://astro.build", external: true },
	{
		label: "Shirone",
		href: "https://github.com/LyraVoid/Shirone",
		external: true,
	},
];
---

<FooterBar
	name={profileConfig.name}
	year={currentYear}
	links={links}
	poweredBy={poweredBy}
	version={version}
	customHtml={splitTrustedHtml(footerHtml).markup}
/>
