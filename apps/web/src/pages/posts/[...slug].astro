---
import IconButton from "@components/atoms/action/IconButton.svelte";
import AccentBar from "@components/atoms/display/AccentBar.svelte";
import Card from "@components/atoms/display/Card.svelte";
import Markdown from "@components/content/Markdown.astro";
import ImageWrapper from "@components/molecules/ImageWrapper.astro";
import LastUpdatedNotice from "@components/molecules/LastUpdatedNotice.astro";
import PostMetadata from "@components/molecules/PostMeta.astro";
import SeriesCard from "@components/molecules/SeriesCard.astro";
import ArticleDiscovery from "@components/organisms/ArticleDiscovery.astro";
import ArticleShare from "@components/organisms/ArticleShare.svelte";
import UmamiStats from "@components/organisms/UmamiStats.astro";
import PostViewTracker from "@components/system/PostViewTracker.astro";
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { discoverArticles } from "@utils/article-discovery";
import { formatDateToYYYYMMDD } from "@utils/date-utils";
import { getMarkdownStylesheetAssets } from "@utils/markdown-assets";
import { getSourceMarkdownSyntaxSnapshot } from "@utils/markdown-source-syntaxes.mjs";
import {
	hasMarkdownSyntax,
	mergeMarkdownSyntaxSnapshots,
} from "@utils/markdown-syntaxes.mjs";
import { buildSeriesPostContext } from "@utils/series-utils";
import { getPostUrlBySlug, url } from "@utils/url-utils";
import { Icon } from "astro-icon/components";
import katexStylesheet from "katex/dist/katex.css?url";
import overlayScrollbarsStylesheet from "overlayscrollbars/overlayscrollbars.css?url";
import {
	resolveArticleDiscoveryOptions,
	resolveArticleShareOptions,
	resolveLastUpdatedNoticeOptions,
} from "@/config";
import { toPostDetailView, toPostView } from "@/lib/content/posts";
import { renderMarkdown } from "@/lib/markdown/render";

const { site, api } = Astro.locals;
const { siteConfig, profileConfig, articleConfig, settings } = site;
const timeZone = siteConfig.timeZone;

const dto = await api.getPost(Astro.params.slug ?? "");
if (!dto) return Astro.rewrite("/404/");
const post = toPostDetailView(dto, timeZone);

// Private / Draft are only served to an authenticated admin: never cache or index.
const isPublic = post.status === "published";
if (!isPublic) Astro.response.headers.set("Cache-Control", "private, no-store");

const series = buildSeriesPostContext(post, site.series);
const seriesCardAtTop = settings.article.seriesCardPosition !== "bottom";

const discoveryOptions = resolveArticleDiscoveryOptions(articleConfig);
const discovery = discoveryOptions
	? discoverArticles(
			post,
			(await api.getArchive()).map((item) => toPostView(item, timeZone)),
			discoveryOptions.relatedCount,
			discoveryOptions.randomCount,
		)
	: { related: [], random: [] };

const rendered = await renderMarkdown(post.contentMarkdown);
const { frontmatter, headings } = rendered;
const renderedMarkdownSyntaxes = frontmatter.markdownSyntaxes;
const sourceMarkdownSyntaxes = hasMarkdownSyntax(
	renderedMarkdownSyntaxes,
	"expressive-code",
)
	? undefined
	: getSourceMarkdownSyntaxSnapshot(post.contentMarkdown);
const markdownSyntaxes = mergeMarkdownSyntaxSnapshots(
	renderedMarkdownSyntaxes,
	sourceMarkdownSyntaxes,
);
const hasMath = hasMarkdownSyntax(markdownSyntaxes, "math");
const markdownStylesheetAssets =
	await getMarkdownStylesheetAssets(markdownSyntaxes);
const words = post.wordCount;
const minutes = Number(frontmatter.minutes ?? 1);

const lastUpdatedNotice = resolveLastUpdatedNoticeOptions(articleConfig);
const shareOptions = resolveArticleShareOptions(articleConfig);
const umamiEnabled = site.umami !== null;
const authorAvatarUrl = profileConfig.avatar || url("/assets/default-avatar.webp");

const pageTitle = post.seoTitle || post.title;
const effectiveDescription = post.seoDescription || post.description || post.title;
const cover = post.cover;
const canonicalPostUrl = post.url;

const jsonLd = {
	"@context": "https://schema.org",
	"@type": "BlogPosting",
	headline: post.title,
	description: effectiveDescription,
	keywords: post.tags.map((tag) => tag.name),
	author: {
		"@type": "Person",
		name: profileConfig.name,
		url: siteConfig.site,
	},
	datePublished: post.publishedAt.toISOString(),
	dateModified: post.updatedAt.toISOString(),
	inLanguage: settings.general.language,
};
---

<MainGridLayout banner={cover?.url} ogImage={cover?.url} title={pageTitle} description={effectiveDescription} bannerDate={formatDateToYYYYMMDD(post.published)} setOGTypeArticle={true} headings={headings} postCategory={post.category?.slug} page="post" noindex={!isPublic}>
    {hasMath && <link slot="head" rel="stylesheet" data-swup-optional="math" href={katexStylesheet} />}
    {hasMath && <link slot="head" rel="stylesheet" data-swup-optional="math" href={overlayScrollbarsStylesheet} />}
    {markdownStylesheetAssets.map(({ pack, css }) => <style is:inline slot="head" data-swup-optional={pack} set:html={css}></style>)}
    {isPublic && <script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)}></script>}
    {isPublic && <PostViewTracker slug={post.slug} />}
    <div class="flex w-full rounded-[var(--radius-large)] overflow-hidden relative mb-4">
		<Card color="var(--card-bg)" radius="l" class="post-card z-10 px-6 md:px-9 pt-6 pb-4 relative w-full">
			<!-- word count and reading time -->
			<div class="flex flex-row text-[var(--on-surface-variant)] gap-5 mb-3 transition onload-animation">
				<div class="flex flex-row items-center">
					<div class="transition h-6 w-6 rounded-[var(--shape-corner-xs)] bg-[var(--surface-container-high)] text-[var(--on-surface-variant)] flex items-center justify-center mr-2">
						<Icon name="material-symbols:notes-rounded"></Icon>
					</div>
					<div class="text-sm">{words} {" " + i18n(words === 1 ? I18nKey.wordCount : I18nKey.wordsCount)}</div>
				</div>
				<div class="flex flex-row items-center">
					<div class="transition h-6 w-6 rounded-[var(--shape-corner-xs)] bg-[var(--surface-container-high)] text-[var(--on-surface-variant)] flex items-center justify-center mr-2">
						<Icon name="material-symbols:schedule-outline-rounded"></Icon>
					</div>
					<div class="text-sm">{minutes} {" " + i18n(minutes === 1 ? I18nKey.minuteCount : I18nKey.minutesCount)}</div>
				</div>
				{umamiEnabled && (
					<div class="flex flex-row items-center">
						<UmamiStats variant="meta" path={canonicalPostUrl} />
					</div>
				)}
			</div>

			<!-- title -->
			<div class="relative onload-animation">
				<div
					class="transition w-full block font-bold mb-3
					text-3xl md:text-[2.25rem]/[2.75rem]
					text-[var(--on-surface)]
					flex items-center gap-3"
				>
					<AccentBar size="large" />
					<div class="inline-block">
						{post.title}
					</div>
					<IconButton
						id="copy-post-link"
						label={i18n(I18nKey.copyLink)}
						class="ml-auto shrink-0"
					>
						<Icon name="material-symbols:link-rounded" class="text-[1.25rem]" />
					</IconButton>
				</div>
			</div>

			<!-- metadata -->
			<div class="onload-animation">
				<PostMetadata
						class="mb-5"
						published={post.published}
						updated={post.updated}
						tags={post.tags}
						category={post.category}
					></PostMetadata>
				{seriesCardAtTop && series && (
					<SeriesCard context={series} class="mb-5 onload-animation" />
				)}
				{!cover && <div class="border-[var(--outline-variant)] border-dashed border-b-[1px] mb-5"></div>}
			</div>

            <!-- always show cover as long as it has one -->

			{cover &&
				<ImageWrapper
					id="post-cover"
					src={cover.url}
					alt={cover.alt ?? ""}
					width={cover.width ?? undefined}
					height={cover.height ?? undefined}
					class="mb-8 rounded-xl banner-container onload-animation"
					loading="eager"
					fetchPriority="high"
				/>
			}

            <Markdown class="mb-6 onload-animation">
                <Fragment set:html={rendered.html} />
            </Markdown>

			{/* 系列块（bottom）紧贴正文之后，先于分享与延伸阅读——系列导航是「继续读」。 */}
			{!seriesCardAtTop && series && (
				<SeriesCard context={series} class="mb-6 onload-animation" />
			)}


			{shareOptions && (
				<ArticleShare
					client:visible
					options={shareOptions}
					title={post.title}
					description={effectiveDescription}
					author={profileConfig.name}
					published={formatDateToYYYYMMDD(post.published)}
					siteTitle={siteConfig.title}
					postPath={canonicalPostUrl}
					coverSelector={cover ? "#post-cover img" : undefined}
					avatarUrl={authorAvatarUrl}
					class="mb-6 rounded-xl onload-animation"
				/>
			)}

			<ArticleDiscovery
				related={discovery.related}
				random={discovery.random}
				class="onload-animation"
			/>

		</Card>
    </div>

    {lastUpdatedNotice && (
        <LastUpdatedNotice
            date={post.updatedAt}
            minimumAgeDays={lastUpdatedNotice.minimumAgeDays}
            class="mb-4 onload-animation"
        />
    )}

    <div class="flex flex-col md:flex-row justify-between mb-4 gap-4 overflow-hidden w-full">
        {post.next ? (
            <Card
                href={getPostUrlBySlug(post.next.slug)}
                color="var(--card-bg)"
                radius="l"
                class="post-nav post-nav--prev w-full font-bold h-[3.75rem] max-w-full px-4 !flex items-center !justify-start gap-4"
            >
                <Icon name="material-symbols:chevron-left-rounded" class="post-nav__arrow text-[2rem] text-[var(--primary)]" />
                <div class="post-nav__title overflow-hidden transition overflow-ellipsis whitespace-nowrap max-w-[calc(100%_-_3rem)]">
                    {post.next.title}
                </div>
            </Card>
        ) : (
            <div class="w-full"></div>
        )}

        {post.previous ? (
            <Card
                href={getPostUrlBySlug(post.previous.slug)}
                color="var(--card-bg)"
                radius="l"
                class="post-nav post-nav--next w-full font-bold h-[3.75rem] max-w-full px-4 !flex items-center !justify-end gap-4"
            >
                <div class="post-nav__title overflow-hidden transition overflow-ellipsis whitespace-nowrap max-w-[calc(100%_-_3rem)]">
                    {post.previous.title}
                </div>
                <Icon name="material-symbols:chevron-right-rounded" class="post-nav__arrow text-[2rem] text-[var(--primary)]" />
            </Card>
        ) : (
            <div class="w-full"></div>
        )}
    </div>

</MainGridLayout>

<style is:global lang="stylus">
	/* 上一篇/下一篇卡片：hover 时标题染色、箭头朝外位移；
	   reduced-motion 下由全局 motion-reduced 规则关闭过渡 */
	.post-nav
		.post-nav__arrow
			transition: transform var(--m3e-duration-medium) var(--m3e-easing-emphasized-decelerate)

		.post-nav__title
			font: var(--m3e-type-title-medium)
			font-weight: 600
			color: var(--on-surface-variant)
			transition: color var(--m3e-duration-short) var(--m3e-easing-standard)

		&:hover .post-nav__title
			color: var(--primary)

		&--prev:hover .post-nav__arrow
			transform: translateX(-0.25rem)

		&--next:hover .post-nav__arrow
			transform: translateX(0.25rem)
</style>
