{
  "name": "@cashewblog/web",
  "type": "module",
  "version": "0.1.0",
  "description": "CashewBlog public frontend (Astro SSR, derived from Shirone)",
  "license": "MIT",
  "scripts": {
    "dev": "node scripts/icons/generate-local-icons.mjs && astro dev --host 127.0.0.1",
    "check": "astro check",
    "type-check": "tsc --noEmit",
    "build": "node scripts/icons/generate-local-icons.mjs && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "icons:generate": "node scripts/icons/generate-local-icons.mjs",
    "design:lint": "node scripts/check-design.mjs",
    "check:manifest": "node scripts/check-manifest.mjs && node scripts/check-markdown-manifest.mjs",
    "test": "node --test \"tests/**/*.test.mjs\"",
    "test:e2e": "playwright test",
    "format": "biome format --write ./src",
    "lint": "biome check --write ./src",
    "seed": "node seed/seed.mjs"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/markdown-remark": "^7.3.1",
    "@astrojs/node": "^11.1.6",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/svelte": "9.0.1",
    "@expressive-code/core": "^0.44.2",
    "@expressive-code/plugin-collapsible-sections": "^0.44.2",
    "@expressive-code/plugin-line-numbers": "^0.44.2",
    "@fancyapps/ui": "^6.1.15",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource/outfit": "^5.3.0",
    "@iconify-json/fa6-brands": "^1.2.6",
    "@iconify-json/fa6-regular": "^1.2.4",
    "@iconify-json/fa6-solid": "^1.2.4",
    "@iconify-json/material-symbols": "^1.2.93",
    "@iconify-json/simple-icons": "^1.2.97",
    "@iconify/svelte": "^5.2.2",
    "@iconify/types": "^2.0.0",
    "@iconify/utils": "^3.1.7",
    "@material/material-color-utilities": "^0.4.0",
    "@panzoom/panzoom": "4.6.2",
    "@swup/astro": "^1.8.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "4",
    "astro": "7.3.5",
    "astro-expressive-code": "^0.44.2",
    "astro-icon": "^1.2.0",
    "hast-util-from-html": "2.0.3",
    "hastscript": "^9.0.1",
    "katex": "^0.16.47",
    "markdown-it": "^14.3.1",
    "mdast-util-to-string": "^4.0.0",
    "mermaid": "^11.17.2",
    "oddmisc": "^1.2.11",
    "overlayscrollbars": "^2.16.0",
    "qrcode": "^1.5.4",
    "reading-time": "^1.5.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-components": "^0.3.0",
    "rehype-expressive-code": "^0.44.2",
    "rehype-katex": "^7.0.1",
    "rehype-slug": "^6.0.0",
    "remark-directive": "^3.0.1",
    "remark-directive-rehype": "^0.4.2",
    "remark-github-admonitions-to-directives": "^1.0.5",
    "remark-math": "^6.0.0",
    "remark-parse": "11.0.0",
    "remark-sectionize": "^2.1.0",
    "sanitize-html": "^2.17.6",
    "sharp": "^0.35.4",
    "stylus": "^0.64.0",
    "svelte": "^5.57.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "unified": "11.0.5",
    "unist-util-visit": "^5.1.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@astrojs/ts-plugin": "^1.10.12",
    "@axe-core/playwright": "^4.13.0",
    "@biomejs/biome": "2.5.14",
    "@playwright/test": "^1.63.0",
    "@rollup/plugin-yaml": "^4.1.2",
    "@swup/scroll-plugin": "3.3.2",
    "@types/hast": "^3.0.5",
    "@types/markdown-it": "^14.2.0",
    "@types/mdast": "^4.0.4",
    "@types/qrcode": "^1.5.6",
    "@types/sanitize-html": "^2.16.1",
    "esbuild": "^0.28.2",
    "vite": "^8.3.1"
  },
  "private": true
}
