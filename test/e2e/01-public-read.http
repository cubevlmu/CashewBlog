@baseUrl = http://127.0.0.1:8080

### 01.01 public settings
GET {{baseUrl}}/api/v1/settings/public
X-Forwarded-For: 10.250.2.1

> {%
  client.test("public settings returns site data", function () {
    client.assert(response.status === 200, "expected HTTP 200");
    client.assert(!!response.body.data.site, "missing site settings");
  });
%}

### 01.02 public home site
GET {{baseUrl}}/api/v1/site/home
X-Forwarded-For: 10.250.2.2

> {%
  client.test("home site returns home data", function () {
    client.assert(response.status === 200, "expected HTTP 200");
    client.assert(!!response.body.data.home, "missing home data");
  });
%}

### 01.03 public blog list
GET {{baseUrl}}/api/v1/blogs?page=1&page_size=10
X-Forwarded-For: 10.250.2.3

> {%
  client.test("public blogs returns a page", function () {
    client.assert(response.status === 200, "expected HTTP 200");
    client.assert(Array.isArray(response.body.data.list), "list should be an array");
    client.assert(response.body.data.list.length > 0, "expected at least one public blog");
  });
  if (response.status === 200 && response.body.data.list.length > 0) {
    client.global.set("publicBlogId", response.body.data.list[0].id);
    client.global.set("publicBlogSlug", response.body.data.list[0].slug);
  }
%}

### 01.04 public blog detail by id
GET {{baseUrl}}/api/v1/blogs/{{publicBlogId}}
X-Forwarded-For: 10.250.2.4

> {%
  client.test("public blog detail returns blog", function () {
    client.assert(response.status === 200, "expected HTTP 200");
    client.assert(response.body.data.blog.id == client.global.get("publicBlogId"), "unexpected blog id");
  });
%}

### 01.05 public blog detail by slug
GET {{baseUrl}}/api/v1/blogs/slug/{{publicBlogSlug}}
X-Forwarded-For: 10.250.2.5

> {%
  client.test("public blog by slug returns blog", function () {
    client.assert(response.status === 200, "expected HTTP 200");
    client.assert(response.body.data.blog.slug === client.global.get("publicBlogSlug"), "unexpected slug");
  });
%}

### 01.06 public blog context by slug
GET {{baseUrl}}/api/v1/blogs/slug/{{publicBlogSlug}}/context
X-Forwarded-For: 10.250.2.6

> {%
  client.test("public blog context returns comments", function () {
    client.assert(response.status === 200, "expected HTTP 200");
    client.assert(Array.isArray(response.body.data.comments), "comments should be an array");
  });
%}

