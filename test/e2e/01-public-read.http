### 01.09 public search
GET {{baseUrl}}/api/v1/search?q=Product&page=1&page_size=10
X-Forwarded-For: 10.250.2.9

> {%
  client.test("search returns keyword and list", function () {
    client.assert(response.status === 200, "expected HTTP 200");
    client.assert(response.body.data.keyword === "Product", "unexpected keyword");
    client.assert(Array.isArray(response.body.data.list), "list should be an array");
  });
%}

