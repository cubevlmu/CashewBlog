@baseUrl = http://127.0.0.1:8080

### 05.01 admin user list through /admin/users
GET {{baseUrl}}/api/v1/admin/users?page=1&page_size=20&keyword=user
X-Forwarded-For: 10.250.6.1
Authorization: Bearer {{adminAccessToken}}

> {%
  client.test("admin users route returns a page", function () {
    client.assert(response.status === 200, "expected HTTP 200");
    client.assert(Array.isArray(response.body.data.list), "list should be an array");
  });
%}

### 05.02 admin user list through /users
GET {{baseUrl}}/api/v1/users?page=1&page_size=20&role=user
X-Forwarded-For: 10.250.6.2
Authorization: Bearer {{adminAccessToken}}

> {%
  client.test("users route returns a page", function () {
    client.assert(response.status === 200, "expected HTTP 200");
    client.assert(Array.isArray(response.body.data.list), "list should be an array");
  });
%}

### 05.03 admin user detail
GET {{baseUrl}}/api/v1/users/1
X-Forwarded-For: 10.250.6.3
Authorization: Bearer {{adminAccessToken}}

> {%
  client.test("user detail returns admin", function () {
    client.assert(response.status === 200, "expected HTTP 200");
    client.assert(response.body.data.user.username === "admin", "unexpected user");
  });
%}

### 05.04 admin create user
POST {{baseUrl}}/api/v1/users
X-Forwarded-For: 10.250.6.4
Authorization: Bearer {{adminAccessToken}}
Content-Type: application/json

{
  "username": "e2e-user-{{runId}}",
  "nickname": "E2E User {{runId}}",
  "email": "e2e-user-{{runId}}@example.test",
  "role": "user",
  "gender": "other",
  "bio": "created by e2e",
  "website": "https://example.test",
  "avatar_id": 1,
  "password": "Password123!"
}

> {%
  client.test("user create returns 201", function () {
    client.assert(response.status === 201, "expected HTTP 201");
    client.assert(!!response.body.data.user.id, "missing user id");
  });
  client.global.set("adminUserId", response.body.data.user.id);
%}

### 05.05 admin update user
PATCH {{baseUrl}}/api/v1/users/{{adminUserId}}
X-Forwarded-For: 10.250.6.5
Authorization: Bearer {{adminAccessToken}}
Content-Type: application/json

{
  "nickname": "E2E User Updated {{runId}}",
  "email": "e2e-user-updated-{{runId}}@example.test",
  "role": "user",
  "gender": "female",
  "bio": "updated by e2e",
  "website": "https://updated.example.test",
  "avatar_id": 1
}

> {%
  client.test("user update returns user", function () {
    client.assert(response.status === 200, "expected HTTP 200");
    client.assert(response.body.data.user.id == client.global.get("adminUserId"), "unexpected user id");
  });
%}

### 05.06 admin update user state through /admin/users
PATCH {{baseUrl}}/api/v1/admin/users/{{adminUserId}}/state
X-Forwarded-For: 10.250.6.6
Authorization: Bearer {{adminAccessToken}}
Content-Type: application/json

{
  "state": "verified"
}

> {%
  client.test("admin user state route returns verified", function () {
    client.assert(response.status === 200, "expected HTTP 200");
    client.assert(response.body.data.state === "verified", "unexpected state");
  });
%}

