### 05.09 admin delete user
DELETE {{baseUrl}}/api/v1/users/{{adminUserId}}
X-Forwarded-For: 10.250.6.9
Authorization: Bearer {{adminAccessToken}}

> {%
  client.test("user delete returns deleted", function () {
    client.assert(response.status === 200, "expected HTTP 200");
    client.assert(response.body.data.deleted === true, "expected deleted=true");
  });
%}

### 05.10 admin create tag
